{
  "customSyntax": "@stylelint/postcss-css-in-js",
  "extends": [
    "stylelint-config-standard",
    "stylelint-config-styled-components",
    "stylelint-config-prettier"
  ],
  "plugins": [
    "stylelint-order"
  ],
  "rules": {
    "color-function-notation": "legacy",
    "alpha-value-notation": "number",
    "value-keyword-case": [
      "lower",
      {
        "camelCaseSvgKeywords": true,
        "ignoreKeywords": [
          "dummyValue"
        ]
      }
    ],
    "declaration-empty-line-before": [
      "always",
      {
        "except": [
          "first-nested"
        ],
        "ignore": [
          "after-comment",
          "after-declaration",
          "inside-single-line-block"
        ]
      }
    ],
    "order/order": [
      "custom-properties",
      "declarations"
    ],
    "order/properties-order": [
      "position",
      "inset",
      "top",
      "right",
      "bottom",
      "left",
      "z-index",
      "display",
      "flex",
      "flex-direction",
      "align-items",
      "justify-content",
      "gap",
      "width",
      "height",
      "padding",
      "margin",
      "background",
      "border",
      "border-radius",
      "box-shadow",
      "color",
      "font",
      "font-size",
      "line-height",
      "text-align",
      "text-transform",
      "white-space",
      "overflow",
      "opacity",
      "transition",
      "transform"
    ]
  }
}